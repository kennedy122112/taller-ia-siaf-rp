# No mostrar el aviso «packages are looking for funding» al instalar.
fund=false
# Instalar siempre las dependencias de desarrollo (Angular CLI, el compilador, Karma): sin ellas `npm start` falla con
# «"ng" no se reconoce como un comando». npm las omite si la PC tiene NODE_ENV=production u omit=dev en su configuración.
include=dev
